#!/bin/sh
# Runs after every `git pull` / `git merge`.
#
# Exists because two Claude sessions on two machines work this repo, and the
# failure mode is not bad code -- it is two sessions doing the same entry, or
# work landing with nothing recorded anywhere. This is the reminder that the
# bookkeeping is part of the job.
#
# Enabled by `git config core.hooksPath .githooks`, which setup.ps1 does and the
# README documents. Hooks under .git/hooks are not tracked, so this directory is.

printf '\n'
printf '\033[1;33m┌─ The Pit ─ before you write code ────────────────────────────┐\033[0m\n'
printf '\033[1;33m│\033[0m 1. Read CLAUDE-READ-THIS.md (the memory) and ROADMAP.md      \033[1;33m│\033[0m\n'
printf '\033[1;33m│\033[0m    (the forward list). Pick from NOW, critical path first.   \033[1;33m│\033[0m\n'
printf '\033[1;33m│\033[0m 2. CLAIM it: mark the box [~] with your date IN ROADMAP.md   \033[1;33m│\033[0m\n'
printf '\033[1;33m│\033[0m    and commit that before you start. Two sessions doing the  \033[1;33m│\033[0m\n'
printf '\033[1;33m│\033[0m    same entry is what this prevents.                         \033[1;33m│\033[0m\n'
printf '\033[1;33m│\033[0m 3. OPEN A GITHUB ISSUE for it, and for anything you find on  \033[1;33m│\033[0m\n'
printf '\033[1;33m│\033[0m    the way. gh issue create -R barongartner/The-Pit          \033[1;33m│\033[0m\n'
printf '\033[1;33m│\033[0m 4. When it lands: tick [x], update the progress count, and   \033[1;33m│\033[0m\n'
printf '\033[1;33m│\033[0m    close the issue (a "fixes #N" trailer does it for you).   \033[1;33m│\033[0m\n'
printf '\033[1;33m└──────────────────────────────────────────────────────────────┘\033[0m\n'

# Claimed-but-unfinished work, so a stalled entry is visible rather than
# rediscovered a week later.
CLAIMED=$(grep -c '^- \[~\]' ROADMAP.md 2>/dev/null | head -1)
if [ "${CLAIMED:-0}" -gt 0 ] 2>/dev/null; then
    printf '\n\033[1;36mIn progress (claimed, not landed):\033[0m\n'
    grep -n '^- \[~\]' ROADMAP.md | sed 's/^/  /' | cut -c1-100
fi

# Migration numbers are the one thing a collision actually breaks: db.migrate
# asserts they are gapless, so two sessions both writing 007 stops the system
# booting.
HIGHEST=$(ls src/thepit/store/schema/*.sql 2>/dev/null | sed 's/.*\///' | cut -c1-3 | sort -n | tail -1)
printf '\n\033[1;36mHighest migration on disk: %s\033[0m — claim the next number in ROADMAP.md before writing it.\n' "${HIGHEST:-none}"

OPEN=$(gh issue list -R barongartner/The-Pit --state open --limit 100 2>/dev/null | wc -l | tr -d ' ')
if [ -n "$OPEN" ] && [ "$OPEN" != "0" ]; then
    printf '\033[1;36mOpen GitHub issues: %s\033[0m — gh issue list -R barongartner/The-Pit\n' "$OPEN"
fi
printf '\n'
